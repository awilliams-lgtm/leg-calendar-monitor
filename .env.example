# Neon / Vercel Postgres
DATABASE_URL=

# Protects /api/cron/*  (Vercel Cron sends this automatically if present)
CRON_SECRET=
SA_KEEP_URL=https://legcalendarmonitor.vercel.app

# Protects POST /api/ingest/sa  (Python scraper or admin push)
INGEST_SECRET=

# Open States API v3  https://openstates.org/accounts/signup/
OPENSTATES_API_KEY=

# State Affairs GraphQL (same API the hearings scraper already hits)
# Prefer signing in from Settings — the session is saved to data/sa-session.json
# (gitignored) and reused. You can still set these as a fallback.
SA_GRAPHQL_URL=https://api.stateaffairs.com/graphql
SA_COOKIE=
SA_BEARER_TOKEN=

# Notifications
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_FROM_EMAIL=calendar-monitor@stateaffairs.com
ALERT_TO_EMAIL=

# Optional. Locks Settings and the shared SA connection to you.
# If unset, the first visit to Settings lets you create a password.
ADMIN_PASSWORD=
