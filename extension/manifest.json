{
  "manifest_version": 3,
  "name": "State Affairs calendar connector",
  "version": "1.1.0",
  "description": "Copies the State Affairs login into the local calendar app, and can capture official legislature calendar pages.",
  "permissions": ["cookies", "storage", "alarms", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.stateaffairs.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Calendar login",
    "default_popup": "popup.html"
  }
}
